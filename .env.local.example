# 2W Federal MD — Environment Variables
# ============================================================
# 1. Copy file ini jadi `.env.local` (tanpa .example)
# 2. Isi dengan kredensial Supabase project-mu:
#    Supabase Dashboard → Project Settings → API
# 3. Restart dev server (npm run dev)
#
# Kalau dua var ini KOSONG / masih 'your-project' → app jalan di MODE DEMO (localStorage).
# ============================================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
